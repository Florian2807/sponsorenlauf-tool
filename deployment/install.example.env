# WLAN shown to the scanning laptops.
AP_SSID="Sponsorenlauf Backend"
AP_PASSPHRASE="Sponsorenlauf!"
AP_CONNECTION_NAME="Sponsorenlauf-Hotspot"

# Raspberry Pi network interfaces and hotspot address.
WLAN_INTERFACE=wlan0
UPLINK_INTERFACE=eth0
AP_IP=10.0.0.1

# Maximum number of automatic SQLite snapshots in the persistent Docker volume.
SPONSORENLAUF_MAX_BACKUPS=20
