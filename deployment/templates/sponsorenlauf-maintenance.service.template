[Unit]
Description=Sponsorenlauf maintenance agent
Requires=docker.service
After=docker.service network-online.target

[Service]
Type=simple
User=root
Environment=SPONSORENLAUF_REPO_DIR=__REPO_DIR__
Environment=SPONSORENLAUF_PRODUCTION_ENV=__REPO_DIR__/deployment/production.env
Environment=SPONSORENLAUF_MAINTENANCE_DIRECTORY=/var/lib/sponsorenlauf/maintenance
ExecStart=__REPO_DIR__/scripts/maintenance-agent.sh
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
